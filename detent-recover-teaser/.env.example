# Copy to .env and fill in. NEVER commit .env.
ELEVENLABS_API_KEY=

# Optional overrides of src/config/film.config.ts (audio section)
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_MUSIC_MODEL=music_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_192

# Landing page form endpoint (e.g. HubSpot Forms API URL). Not used by the film render.
REGISTRATION_FORM_ENDPOINT=
